# Config web Firebase (publique par nature : la sécurité repose sur les règles + App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Clé de site reCAPTCHA v3 pour App Check (laisser vide en local)
VITE_RECAPTCHA_SITE_KEY=
# Sign in with Apple (nécessite un compte Apple Developer)
VITE_ENABLE_APPLE=false
# true = utiliser les émulateurs locaux (auth:9099, firestore:8080)
VITE_USE_EMULATORS=false
