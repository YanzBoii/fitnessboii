{
  "name": "fitnessboii",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-fitnessboii",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run tests/domain",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fitnessboii \"vitest run tests/rules\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "preview:emu": "vite build --mode emulator --outDir dist-emu && vite preview --mode emulator --outDir dist-emu"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.32.1",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
