rules_version = '2';

// FitnessBoii â€” rÃ¨gles Firestore.
// Principe : tout est privÃ©. Chaque utilisateur ne peut lire/Ã©crire que sous
// users/{son uid}, avec un email vÃ©rifiÃ©, et chaque Ã©criture est validÃ©e
// (champs autorisÃ©s, types, bornes). Tout ce qui n'est pas listÃ© est refusÃ©.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    // Email/mot de passe : email vÃ©rifiÃ© obligatoire. Google : toujours vÃ©rifiÃ©.
    function verified() {
      return request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return signedIn() && verified() && request.auth.uid == uid;
    }
    function data() {
      return request.resource.data;
    }
    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isNum(v, min, max) {
      return (v is int || v is float) && v >= min && v <= max;
    }
    function isInt(v, min, max) {
      return v is int && v >= min && v <= max;
    }
    function validId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,40}$');
    }
    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validDays(v) {
      return v is list && v.size() <= 7 && v.hasOnly([0, 1, 2, 3, 4, 5, 6]);
    }

    // ---------- Profil + rÃ©glages : users/{uid} ----------
    function validProfile() {
      let d = data();
      return d.keys().hasOnly(['name', 'goalType', 'level', 'bodyWeight', 'height', 'goal',
                               'rest', 'autoTimer', 'remind', 'theme', 'mode', 'onboarded',
                               'createdAt', 'updatedAt'])
        && isStr(d.get('name', ''), 0, 40)
        && (d.get('goalType', 'masse') in ['masse', 'seche', 'force', 'forme'])
        && (d.get('level', 'debutant') in ['debutant', 'inter', 'avance'])
        && isNum(d.get('bodyWeight', 75), 20, 400)
        && isNum(d.get('height', 175), 100, 250)
        && isInt(d.get('goal', 3), 1, 7)
        && (d.get('rest', 90) in [60, 90, 120, 180])
        && d.get('autoTimer', true) is bool
        && d.get('remind', false) is bool
        && (d.get('theme', 'rubis') in ['rubis', 'braise', 'ocean', 'menthe', 'violet', 'solaire'])
        && (d.get('mode', 'dark') in ['dark', 'light'])
        && d.get('onboarded', false) is bool
        && d.get('createdAt', request.time) is timestamp
        && d.get('updatedAt', request.time) is timestamp;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();

      // ---------- Programmes : users/{uid}/programs/{programId} ----------
      // Les exercices sont une liste de maps (max 40) : Firestore ne permet pas
      // de boucler sur une liste dans les rÃ¨gles, leur forme est validÃ©e cÃ´tÃ©
      // app ; la taille reste bornÃ©e (40 Ã©lÃ©ments, 1 Mo max par document).
      match /programs/{programId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validId(programId)
          && data().keys().hasOnly(['name', 'subtitle', 'icon', 'days', 'exercises', 'order', 'createdAt'])
          && isStr(data().name, 1, 60)
          && isStr(data().subtitle, 0, 80)
          && data().icon in ['fitness_center', 'rowing', 'directions_run', 'sports_gymnastics',
                             'local_fire_department', 'bolt', 'self_improvement', 'sprint']
          && validDays(data().days)
          && data().exercises is list && data().exercises.size() <= 40
          && isInt(data().order, 0, 1000)
          && data().get('createdAt', request.time) is timestamp;
      }

      // ---------- SÃ©ances terminÃ©es : users/{uid}/sessionLogs/{yyyy-mm-dd} ----------
      // 1 document par jour : perf max de chaque exercice + durÃ©e.
      match /sessionLogs/{dateKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDateKey(dateKey)
          && data().keys().hasOnly(['date', 'programId', 'programName', 'minutes', 'perf', 'createdAt'])
          && data().date == dateKey
          && isStr(data().programId, 1, 40)
          && isStr(data().programName, 0, 60)
          && isInt(data().minutes, 1, 600)
          && data().perf is map && data().perf.size() <= 40
          && data().createdAt is timestamp;
      }

      // ---------- SÃ©ance en cours : users/{uid}/session/current ----------
      match /session/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'current'
          && data().keys().hasOnly(['programId', 'startedAt', 'cur', 'ex'])
          && isStr(data().programId, 1, 40)
          && isInt(data().startedAt, 0, 9999999999999)
          && isInt(data().cur, 0, 100)
          && data().ex is map && data().ex.size() <= 40;
      }

      // ---------- Photos : mÃ©tadonnÃ©es (liste lÃ©gÃ¨re) ----------
      match /photos/{week} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDateKey(week)
          && data().keys().hasOnly(['week', 'date', 'createdAt'])
          && data().week == week
          && isDateKey(data().date)
          && data().createdAt is timestamp;
      }

      // ---------- Photos : image JPEG compressÃ©e (octets bruts) ----------
      match /photoData/{week} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDateKey(week)
          && data().keys().hasOnly(['type', 'bytes'])
          && data().type == 'image/jpeg'
          && data().bytes is bytes
          && data().bytes.size() > 0
          && data().bytes.size() <= 900000;
      }
    }

    // Tout le reste : refusÃ©.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
